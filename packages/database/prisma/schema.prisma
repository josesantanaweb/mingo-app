generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  username           String?  @unique
  passwordHash       String?
  role               UserRole @default(USER)
  isEmailVerified    Boolean  @default(false)
  isTwoFactorEnabled Boolean  @default(false)
  twoFactorSecret    String?

  sessions      Session[]
  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]

  tokens  Decimal @db.Decimal(10, 2) @default(0.0)
  credits Decimal @db.Decimal(10, 2) @default(0.0)

  participations Operation[]
  transactions   Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String  @id @default(cuid())
  userId    String
  userAgent String?
  ipAddress String?
  isActive  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String  @id @default(cuid())
  token     String  @unique
  userId    String
  isRevoked Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id     String  @id @default(cuid())
  code   String
  type   OtpType
  userId String
  isUsed Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, type])
  @@map("otp_codes")
}

model ExchangeRate {
  id   String   @id @default(cuid())
  rate Decimal @db.Decimal(10, 2)
  date DateTime @unique @default(now())

  @@map("exchange_rates")
}

model RewardConfig {
  id         String     @id @default(cuid())
  title      String // Ej: "Pozo Acumulado de Tokens" o "Camisa Oficial del Madrid"
  rewardType RewardType // DIGITAL_CREDIT, PHYSICAL_PRODUCT, GIFT_CARD, POOL_DIVIDEND
  value      Decimal @db.Decimal(10, 2) // Para créditos digitales, el valor en tokens o créditos. Para productos físicos, el valor monetario estimado.

  gameEvents GameEvent[]
  operations Operation[]

  @@map("reward_configs")
}

model GameEvent {
  id             String    @id @default(cuid())
  gameType       GameType
  date           DateTime
  schedule       Schedule?
  rewardConfigId String

  winningResult String?
  isProcessed   Boolean @default(false)

  rewardConfig   RewardConfig @relation(fields: [rewardConfigId], references: [id])
  participations Operation[]

  @@map("game_events")
}

model Operation {
  id             String   @id @default(cuid())
  userId         String
  gameType       GameType
  gameEventId    String?
  rewardConfigId String?

  // gameMetadata   Json?

  costTokens     Decimal         @db.Decimal(10, 2)
  currencyUsed   CurrencyType    @default(TOKEN)
  rateAtPurchase Decimal         @db.Decimal(10, 2)
  status         OperationStatus @default(PENDING)

  user         User          @relation(fields: [userId], references: [id])
  gameEvent    GameEvent?    @relation(fields: [gameEventId], references: [id])
  rewardConfig RewardConfig? @relation(fields: [rewardConfigId], references: [id])

  createdAt DateTime @default(now())

  @@map("operations")
}

model Transaction {
  id     String @id @default(cuid())
  userId String

  amountVes    Decimal @db.Decimal(10, 2) // Cantidad exacta en Bolívares de la operación
  amountUsd     Decimal @db.Decimal(10, 2) // Equivalente exacto en dólares ($)
  rateAtProcess Decimal @db.Decimal(10, 2) // La tasa de cambio del día/momento en que se ejecuta la transacción

  tokensGiven   Decimal @default(0.0) @db.Decimal(10, 2) // Si es recarga: cuántos tokens se le sumaron
  creditsBurned Decimal

  type        TransactionType
  description String?
  capture     String?
  reference   String? // Para depósitos bancarios/pago móvil

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("transactions")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  USER
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

enum TransactionType {
  TOKEN_PURCHASE
  CREDIT_REDEMPTION
  REWARD_PRIZE
}

enum CurrencyType {
  TOKEN
  CREDIT
}

enum GameType {
  DRAW
  BINGO
  MINES
  SPORTS
}

enum LotteryType {
  A
  B
}

enum RewardType {
  DIGITAL_CREDIT
  PHYSICAL_PRODUCT
  GIFT_CARD
  POOL_DIVIDEND
}

enum Schedule {
  NOON // 1:15 PM
  NIGHT // 10:10 PM
}

enum OperationStatus {
  PENDING
  REWARDED
  COMPLETED
  CANCELLED
}
