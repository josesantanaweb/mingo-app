generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  username           String?  @unique
  passwordHash       String?
  role               UserRole @default(USER)
  isEmailVerified    Boolean  @default(false)
  isTwoFactorEnabled Boolean  @default(false)
  twoFactorSecret    String?

  sessions      Session[]
  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]

  balance      Decimal  @default(0.0) @db.Decimal(10, 2)

  bets         Bet[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String  @id @default(cuid())
  userId    String
  userAgent String?
  ipAddress String?
  isActive  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String  @id @default(cuid())
  token     String  @unique
  userId    String
  isRevoked Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id     String  @id @default(cuid())
  code   String
  type   OtpType
  userId String
  isUsed Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, type])
  @@map("otp_codes")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  rate      Float
  date      DateTime @unique @default(now())

  @@map("exchange_rates")
}

model Draw {
  id           String      @id @default(cuid())
  date         DateTime    // Fecha del sorteo
  schedule     Schedule    // MEDIODIA o NOCHE
  lotteryType  LotteryType // A o B
  winningNumber Int?       // 1 al 99 (null hasta que se realice el sorteo)
  isProcessed  Boolean     @default(false)

  bets         Bet[]

  @@unique([date, schedule, lotteryType])
  @@map("draws")
}

model Bet {
  id             String    @id @default(cuid())
  userId         String
  drawId         String
  selectedNumber Int       // 1 al 99
  amountUsd      Decimal   @default(1.0) @db.Decimal(10, 2)
  rateAtPurchase Decimal   @db.Decimal(10, 2) // Guardamos la tasa BCV del momento de compra
  status         BetStatus @default(PENDING)

  user           User      @relation(fields: [userId], references: [id])
  draw           Draw      @relation(fields: [drawId], references: [id])

  createdAt      DateTime  @default(now())

  @@map("bets")
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  description String?
  reference   String?         // Para depósitos bancarios/pago móvil

  user        User            @relation(fields: [userId], references: [id])
  createdAt   DateTime        @default(now())

  @@map("transactions")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  USER
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_PURCHASE
  WINNING_PRIZE
}

enum LotteryType {
  A
  B
}

enum Schedule {
  NOON     // 1:15 PM
  NIGHT    // 10:10 PM
}

enum BetStatus {
  PENDING
  WON
  LOST
  CANCELLED
}
